#!/usr/bin/env python3
"""Sovereign Mission Control hub — status + inventory API (WP-08)."""
from __future__ import annotations

import json
import os
import subprocess
import sys
import urllib.error
import urllib.request
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import urlparse

HOME = Path.home()
BIN = HOME / ".local/bin"
HOST = os.environ.get("SOVEREIGN_HUB_HOST", "127.0.0.1")
PORT = int(os.environ.get("SOVEREIGN_HUB_PORT", "8766"))
STATIC_CANDIDATES = [
    HOME / ".local/share/sovereign-hub/static",
    Path(__file__).resolve().parent.parent / "static",
]
STATIC = next((p for p in STATIC_CANDIDATES if (p / "index.html").is_file()), STATIC_CANDIDATES[0])


def load_env() -> None:
    envf = HOME / ".config/sovereign/env"
    if envf.is_file():
        for line in envf.read_text().splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, _, v = line.partition("=")
            k = k.replace("export ", "").strip()
            v = v.strip().strip('"').strip("'")
            os.environ.setdefault(k, os.path.expandvars(v.replace("$HOME", str(HOME))))
    os.environ["PATH"] = str(BIN) + ":" + os.environ.get("PATH", "")
    os.environ.setdefault("SOVEREIGN_DATA_ROOT", str(HOME / ".local/share/sovereign"))


def _get(url: str, timeout: float = 2.0) -> dict | None:
    try:
        with urllib.request.urlopen(url, timeout=timeout) as r:
            return json.loads(r.read().decode())
    except Exception:
        return None


def data_root() -> Path:
    return Path(os.environ.get("SOVEREIGN_DATA_ROOT", HOME / ".local/share/sovereign"))


def status_bundle() -> dict:
    cu = _get("http://127.0.0.1:8765/health")
    sys_h = _get("http://127.0.0.1:8767/health")
    ollama = _get("http://127.0.0.1:11434/api/tags", timeout=1.5)
    daemon = False
    try:
        p = subprocess.run(
            ["systemctl", "--user", "is-active", "sovereign-daemon"],
            capture_output=True,
            text=True,
            timeout=3,
        )
        daemon = p.stdout.strip() == "active"
    except Exception:
        pass
    model = os.environ.get("SOVEREIGN_OLLAMA_MODEL", "")
    return {
        "ok": True,
        "daemon": daemon,
        "computer_use": bool(cu and cu.get("ok")),
        "sys": bool(sys_h and sys_h.get("ok")),
        "ollama": bool(ollama and "models" in ollama),
        "model": model,
        "data_root": str(data_root()),
        "cu": cu,
        "sys_health": sys_h,
    }


def ensure_ready() -> dict:
    notes = []
    try:
        p = subprocess.run(
            ["systemctl", "--user", "is-active", "sovereign-daemon"],
            capture_output=True,
            text=True,
            timeout=3,
        )
        if p.stdout.strip() != "active":
            subprocess.run(["systemctl", "--user", "start", "sovereign-daemon"], capture_output=True, timeout=10)
            notes.append("started daemon")
    except Exception as e:
        notes.append(f"daemon: {e}")
    if not _get("http://127.0.0.1:8765/health"):
        cu = BIN / "sovereign-cu-server"
        if cu.is_file():
            subprocess.Popen(
                [str(cu)],
                start_new_session=True,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                env=os.environ.copy(),
            )
            notes.append("spawned cu-server")
    if not _get("http://127.0.0.1:8767/health"):
        sy = BIN / "sovereign-sys-server"
        if sy.is_file():
            subprocess.Popen(
                [str(sy)],
                start_new_session=True,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                env=os.environ.copy(),
            )
            notes.append("spawned sys-server")
    if not _get("http://127.0.0.1:8769/health"):
        sc = HOME / ".local/share/sovereign-hub/caps_sidecar.py"
        if sc.is_file():
            subprocess.Popen(
                [sys.executable, str(sc)],
                start_new_session=True,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                env=os.environ.copy(),
            )
            notes.append("spawned caps-sidecar")
    return {"ok": True, "notes": notes, **status_bundle()}


def _inv_handle(path: str, body: dict | None = None) -> dict:
    body = body or {}
    try:
        sys.path.insert(0, str(HOME / ".local/share/sovereign-inventory/src"))
        from sovereign_inventory import scan as inv_scan  # type: ignore
    except Exception:
        inv_scan = None

    if path.rstrip("/").endswith("/scan"):
        if inv_scan:
            p = inv_scan.scan_apps()
            return {"ok": True, "count": p.get("count"), "scanned_at": p.get("scanned_at")}
        return {"ok": False, "error": "sovereign_inventory missing"}
    if path.rstrip("/").endswith("/set"):
        aid = str(body.get("id") or "")
        allow = bool(body.get("allow", False))
        if inv_scan:
            return inv_scan.set_allow(aid, allow)
        return {"ok": False, "error": "sovereign_inventory missing"}
    # list
    if inv_scan:
        return inv_scan.inventory_with_policy()
    inv_p = data_root() / "inventory" / "apps.json"
    pol_p = data_root() / "inventory" / "app_policy.json"
    apps = json.loads(inv_p.read_text()).get("apps", []) if inv_p.is_file() else []
    pol = json.loads(pol_p.read_text()).get("apps", {}) if pol_p.is_file() else {}
    out = []
    for a in apps:
        meta = pol.get(a.get("id", {}), {})
        allow = bool(meta.get("allow")) if isinstance(meta, dict) else str(meta).lower() in ("allow", "true")
        out.append({**a, "allow": allow})
    return {
        "ok": True,
        "count": len(out),
        "allowed_count": sum(1 for x in out if x.get("allow")),
        "apps": out,
    }


class Handler(SimpleHTTPRequestHandler):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, directory=str(STATIC), **kwargs)

    def log_message(self, fmt: str, *args) -> None:
        sys.stderr.write("[hub] " + (fmt % args) + "\n")

    def _send_json(self, data: dict, code: int = 200) -> None:
        raw = json.dumps(data).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(raw)))
        self.end_headers()
        self.wfile.write(raw)

    def do_GET(self) -> None:  # noqa: N802
        path = urlparse(self.path).path
        if path.startswith("/api/inventory"):
            try:
                self._send_json(_inv_handle(path))
            except Exception as e:
                self._send_json({"ok": False, "error": str(e)}, 500)
            return
        if path in ("/api/status", "/api/status/"):
            self._send_json(status_bundle())
            return
        if path in ("/api/ensure", "/api/ensure/"):
            self._send_json(ensure_ready())
            return
        if path in ("/", "/index.html"):
            index = STATIC / "index.html"
            if index.is_file():
                data = index.read_bytes()
                self.send_response(200)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.send_header("Content-Length", str(len(data)))
                self.end_headers()
                self.wfile.write(data)
                return
        super().do_GET()

    def do_POST(self) -> None:  # noqa: N802
        path = urlparse(self.path).path
        n = int(self.headers.get("Content-Length", 0) or 0)
        raw = self.rfile.read(n) if n else b"{}"
        try:
            body = json.loads(raw.decode() or "{}")
        except Exception:
            body = {}
        if path.startswith("/api/inventory"):
            try:
                self._send_json(_inv_handle(path, body if isinstance(body, dict) else {}))
            except Exception as e:
                self._send_json({"ok": False, "error": str(e)}, 500)
            return
        if path in ("/api/ensure", "/api/ensure/"):
            self._send_json(ensure_ready())
            return
        if path in ("/api/status", "/api/status/"):
            self._send_json(status_bundle())
            return
        self._send_json({"ok": False, "error": f"unknown api {path}"}, 404)


def main() -> None:
    load_env()
    STATIC.mkdir(parents=True, exist_ok=True)
    httpd = ThreadingHTTPServer((HOST, PORT), Handler)
    print(f"sovereign-hub listening on http://{HOST}:{PORT} static={STATIC}", flush=True)
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("hub stopped", flush=True)


if __name__ == "__main__":
    main()
